{
  "name": "cosmo-mail",
  "version": "0.1.0",
  "description": "CosmoMail (CMail) – AI Email Simulator",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "build": "esbuild public/app.js --bundle --outfile=public/app.bundle.js --format=esm --platform=browser",
    "build:watch": "esbuild public/app.js --bundle --outfile=public/app.bundle.js --format=esm --platform=browser --watch",
    "start": "npm run build && node server.js",
    "start:prod": "npm run build && cross-env AGENT_TARGET=prod node server.js",
    "dev": "npm run build && concurrently -k -n client,server -c blue,green \"npm:build:watch\" \"node --watch server.js\"",
    "validate:agent": "octavus --env .env validate ./agents/cosmo-mail && octavus --env .env validate ./agents/cosmo-mail-character",
    "deploy:agent": "node scripts/deploy-agent.mjs",
    "deploy:agent:dev": "node scripts/deploy-agent.mjs dev",
    "deploy:agent:prod": "node scripts/deploy-agent.mjs prod",
    "deploy:character-agent:dev": "node scripts/deploy-agent.mjs dev --agent cosmo-mail-character",
    "deploy:character-agent:prod": "node scripts/deploy-agent.mjs prod --agent cosmo-mail-character",
    "extract": "node extract-conversations.js",
    "report": "node extract-conversations.js --mode report --print-settings",
    "report:chronological": "node extract-conversations.js --mode report --print-settings --order chronological",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "node scripts/pack-dist.mjs"
  },
  "dependencies": {
    "@octavus/client-sdk": "^6.10.0",
    "@octavus/server-sdk": "^6.10.0",
    "@tiptap/core": "^3.0.0",
    "@tiptap/markdown": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.3",
    "marked-highlight": "^2.2.4"
  },
  "devDependencies": {
    "@octavus/cli": "^6.10.0",
    "concurrently": "^10.0.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.6"
  }
}
