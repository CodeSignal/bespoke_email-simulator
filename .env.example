# Octavus platform connection
OCTAVUS_API_URL=https://octavus.ai
OCTAVUS_API_KEY=oct_sk_your_key_here

# Which pair of agents to use: "dev" or "prod". Defaults to "prod" when unset.
# Runtime: `npm run dev` forces dev; `npm start` uses this value (or prod).
# Deploy:  `npm run deploy:agent` pushes both agent definitions to this target.
AGENT_TARGET=prod

# Cosmo copilot (cosmo-mail / cosmo-mail-dev)
# Find ids with: npx octavus --env .env list
OCTAVUS_AGENT_ID_DEV=your_dev_agent_id
OCTAVUS_AGENT_ID_PROD=your_prod_agent_id

# Legacy single-agent var. Still honored as a fallback when the target-specific
# ID above is not set, so older .env files keep working without changes.
# OCTAVUS_AGENT_ID=your_agent_id

# Character correspondent (cosmo-mail-character / cosmo-mail-character-dev)
OCTAVUS_CHARACTER_AGENT_ID_DEV=your_dev_character_agent_id
OCTAVUS_CHARACTER_AGENT_ID_PROD=your_prod_character_agent_id

# Optional: HTTP port (default 3000)
# PORT=3000
